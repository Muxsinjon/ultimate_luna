@@ -0,0 +1,77 @@
+import { readFileSync } from 'node:fs'
+import { createHash } from 'node:crypto'
+import { describe, expect, it } from 'vitest'
+import { meshArrays, localToSurface, surfaceToLocal, sampleGrid, validateTerrain, type TerrainAsset } from './terrainMesh'
+import { polarLatLon } from './terrain'
+import { DEFAULT_STATE, fromHash, toHash } from './state'
+const base = new URL('../../public/data/terrain/site01/', import.meta.url)
+const meta = JSON.parse(readFileSync(new URL('terrain.json', base), 'utf8'))
+const load = (file: string) => {
+  const b = readFileSync(new URL(file, base))
+  return new Float32Array(b.buffer.slice(b.byteOffset, b.byteOffset + b.byteLength))
+}
+const asset: TerrainAsset = { meta, heights: load('elevation.f32'), errors: load('uncertainty.f32'), imageUrl: null }
+const arrays = meshArrays(asset)
+describe('real NASA Site01 terrain', () => {
+  it('verifies checked-in asset checksums and native metadata', () => {
+    validateTerrain(asset)
+    for (const a of [...Object.values(meta.assets), meta.imagery] as { file: string; sha256: string }[])
+      expect(
+        createHash('sha256')
+          .update(readFileSync(new URL(a.file, base)))
+          .digest('hex'),
+      ).toBe(a.sha256)
+    expect(meta.sources.surf.metadata.resolutionM).toEqual([5, 5])
+    expect(meta.sources.surf.metadata.width).toBe(3200)
+  })
+  it('matches independent native-source checkpoints throughout the subset', () => {
+    for (const p of meta.alignment.checkpoints) {
+      expect(asset.heights[p.row * meta.width + p.col]).toBeCloseTo(p.elevationM, 5)
+      expect(sampleGrid(asset, p.lat, p.lon)).toBeCloseTo(p.elevationM, 5)
+      expect(p.projectionErrorM).toBeLessThan(1e-6)
+    }
+    expect(sampleGrid(asset, -89.53432, 209.94767)).toBeGreaterThan(1600)
+    expect(sampleGrid(asset, -89.53432, 209.94767)).toBeLessThan(1700)
+  })
+  it('round trips curved mesh positions and radial heights at real vertices', () => {
+    for (const p of meta.alignment.checkpoints) {
+      const ll = polarLatLon(meta.x0 + p.col * meta.dx, meta.y0 + p.row * meta.dy)
+      const point = { ...ll, elevationM: p.elevationM },
+        local = surfaceToLocal(point, arrays.origin),
+        result = localToSurface(local, arrays.origin)
+      expect(result.lat).toBeCloseTo(p.lat, 9)
+      expect(result.lon).toBeCloseTo(p.lon, 9)
+      expect(result.elevationM).toBeCloseTo(point.elevationM, 6)
+      const i = p.row * meta.width + p.col
+      expect(Math.hypot(...local.map((n, j) => n - arrays.positions[i * 3 + j]))).toBeLessThan(0.002)
+    }
+    expect(arrays.indices.length).toBe(400 * 400 * 6)
+  })
+  it('excludes NoData triangles and rejects out-of-coverage or wrong-planet data', () => {
+    const missing = asset.heights.slice()
+    missing[0] = NaN
+    const next = meshArrays({ ...asset, heights: missing })
+    expect(next.indices[0]).not.toBe(0)
+    expect(next.indices.length).toBe(arrays.indices.length - 3)
+    const ll = polarLatLon(meta.x0, meta.y0)
+    expect(sampleGrid({ ...asset, heights: missing }, ll.lat, ll.lon)).toBeNull()
+    expect(sampleGrid(asset, 0, 0)).toBeNull()
+    expect(() => validateTerrain({ ...asset, meta: { ...meta, radiusM: 6378137 } })).toThrow()
+    expect(() => validateTerrain({ ...asset, heights: missing.slice(1) })).toThrow()
+  })
+  it('retains measured source RMS separately from rendering residuals', () => {
+    expect(sampleGrid(asset, meta.origin.lat, meta.origin.lon, asset.errors)).toBeGreaterThan(0)
+    expect(meta.decimationResidualM.samples).toBe(1601 * 1601)
+    expect(meta.decimationResidualM.rms).toBeGreaterThan(0)
+  })
+  it('maps imagery UV edges to the exact projected vertex bounds', () => {
+    const p = JSON.parse(readFileSync(new URL('imagery-provenance.json', base), 'utf8'))
+    expect(p.targetBounds).toEqual([meta.x0, meta.y0 + 400 * meta.dy, meta.x0 + 400 * meta.dx, meta.y0])
+    expect(Array.from(arrays.uv.slice(0, 2))).toEqual([0, 1])
+    expect(Array.from(arrays.uv.slice(-2))).toEqual([1, 0])
+  })
+  it('round trips shared terrain workspace and landing-site selection', () => {
+    const s = { ...DEFAULT_STATE, ws: 'terrain' as const, surfaceSite: 'B' as const }
+    expect(fromHash(toHash(s))).toEqual(s)
+  })
+})
diff --git a/web/src/lib/terrainMesh.ts b/web/src/lib/terrainMesh.ts
new file mode 100644
index 0000000..eccad86
--- /dev/null
+++ b/web/src/lib/terrainMesh.ts
@@ -0,0 +1,153 @@
+import { D2R, enuBasis, unitVec, type Vec3 } from './geometry'
+import { polarXY, polarLatLon } from './terrain'
+
+export interface SurfacePoint {
+  lat: number
+  lon: number
+  elevationM: number
+}
+interface AssetFile {
+  file: string
+  sha256: string
+  min: number
+  max: number
+  median: number
+}
+export interface TerrainMeta {
+  version: number
+  width: number
+  height: number
+  x0: number
+  y0: number
+  dx: number
+  dy: number
+  radiusM: number
+  projection: string
+  frame: string
+  origin: { lat: number; lon: number }
+  sourceResolutionM: number
+  assets: { surf: AssetFile; toterr: AssetFile }
+  decimationResidualM: { rms: number; p95Abs: number; maxAbs: number }
+  uncertaintyNote: string
+  sources: Record<string, { url: string; file: string; sha256: string }>
+  imagery: null | { file: string; sha256: string; title: string; url: string; note: string }
+}
+export interface TerrainAsset {
+  meta: TerrainMeta
+  heights: Float32Array
+  errors: Float32Array
+  imageUrl: string | null
+}
+const R = 1737400
+export const terrainBase = `${import.meta.env.BASE_URL}data/terrain/site01/`
+
+export function validateTerrain(asset: TerrainAsset) {
+  const { meta: m, heights, errors } = asset
+  if (
+    m.version !== 1 ||
+    m.radiusM !== R ||
+    m.projection !== 'south-polar-stereographic' ||
+    ![m.width, m.height].every((n) => Number.isInteger(n) && n >= 2 && n <= 1025) ||
+    ![m.x0, m.y0, m.dx, m.dy, m.origin.lat, m.origin.lon].every(Number.isFinite) ||
+    m.dx <= 0 ||
+    m.dy >= 0 ||
+    heights.length !== m.width * m.height ||
+    errors.length !== heights.length ||
+    !heights.some(Number.isFinite)
+  ) {
+    throw new Error('Unsupported or incomplete lunar terrain asset')
+  }
+}
+/** Never clamp coordinates or bridge NoData gaps. Grid values are radial elevations/RMS errors. */
+export function sampleGrid(asset: TerrainAsset, lat: number, lon: number, values = asset.heights): number | null {
+  const { meta: m } = asset,
+    { x, y } = polarXY(lat, lon)
+  const c = (x - m.x0) / m.dx,
+    r = (y - m.y0) / m.dy
+  if (![c, r].every(Number.isFinite) || c < -1e-8 || r < -1e-8 || c > m.width - 1 + 1e-8 || r > m.height - 1 + 1e-8) return null
+  const c0 = Math.max(0, Math.min(m.width - 2, Math.floor(c))),
+    r0 = Math.max(0, Math.min(m.height - 2, Math.floor(r)))
+  const a = [values[r0 * m.width + c0], values[r0 * m.width + c0 + 1], values[(r0 + 1) * m.width + c0], values[(r0 + 1) * m.width + c0 + 1]]
+  if (!a.every(Number.isFinite)) return null
+  const fc = Math.max(0, Math.min(1, c - c0)),
+    fr = Math.max(0, Math.min(1, r - r0))
+  return (a[0] * (1 - fc) + a[1] * fc) * (1 - fr) + (a[2] * (1 - fc) + a[3] * fc) * fr
+}
+/** Curved lunar surface in metres, local X east, Y up, Z south. */
+export function surfaceToLocal(p: SurfacePoint, origin: SurfacePoint): Vec3 {
+  const b = enuBasis(origin.lon, origin.lat),
+    u = unitVec(p.lon, p.lat),
+    o = unitVec(origin.lon, origin.lat)
+  const v = u.map((n, i) => n * (R + p.elevationM) - o[i] * (R + origin.elevationM))
+  const dot = (a: Vec3) => v.reduce((s, n, i) => s + n * a[i], 0)
+  return [dot(b.e), dot(b.u), -dot(b.n)]
+}
+export function localToSurface(p: Vec3, origin: SurfacePoint): SurfacePoint {
+  const b = enuBasis(origin.lon, origin.lat),
+    u = unitVec(origin.lon, origin.lat)
+  const v = u.map((n, i) => n * (R + origin.elevationM) + b.e[i] * p[0] + b.u[i] * p[1] - b.n[i] * p[2])
+  return {
+    lat: Math.atan2(v[2], Math.hypot(v[0], v[1])) / D2R,
+    lon: (((Math.atan2(v[1], v[0]) / D2R) % 360) + 360) % 360,
+    elevationM: Math.hypot(...v) - R,
+  }
+}
+export function meshArrays(asset: TerrainAsset) {
+  validateTerrain(asset)
+  const { meta: m, heights: h } = asset
+  const origin = { ...m.origin, elevationM: sampleGrid(asset, m.origin.lat, m.origin.lon) ?? 0 }
+  const positions = new Float32Array(h.length * 3),
+    uv = new Float32Array(h.length * 2),
+    indices: number[] = []
+  for (let r = 0; r < m.height; r++)
+    for (let c = 0; c < m.width; c++) {
+      const i = r * m.width + c,
+        ll = polarLatLon(m.x0 + c * m.dx, m.y0 + r * m.dy)
+      positions.set(surfaceToLocal({ ...ll, elevationM: Number.isFinite(h[i]) ? h[i] : 0 }, origin), i * 3)
+      uv.set([c / (m.width - 1), 1 - r / (m.height - 1)], i * 2)
+    }
+  for (let r = 0; r < m.height - 1; r++)
+    for (let c = 0; c < m.width - 1; c++) {
+      const a = r * m.width + c,
+        b = a + 1,
+        d = a + m.width,
+        e = d + 1
+      for (const tri of [
+        [a, d, b],
+        [b, d, e],
+      ])
+        if (tri.every((i) => Number.isFinite(h[i]))) indices.push(...tri)
+    }
+  if (!indices.length) throw new Error('No valid terrain triangles')
+  return { origin, positions, uv, indices: new Uint32Array(indices) }
+}
+async function checkedFile(file: { file: string; sha256: string }, signal?: AbortSignal) {
+  const r = await fetch(terrainBase + file.file, { signal })
+  if (!r.ok) throw new Error(`Could not load terrain ${file.file} (HTTP ${r.status})`)
+  const bytes = await r.arrayBuffer(),
+    hash = await crypto.subtle.digest('SHA-256', bytes)
+  if (Array.from(new Uint8Array(hash), (b) => b.toString(16).padStart(2, '0')).join('') !== file.sha256)
+    throw new Error('Terrain checksum mismatch')
+  return bytes
+}
+function decode(bytes: ArrayBuffer) {
+  if (bytes.byteLength % 4) throw new Error('Truncated terrain file')
+  const view = new DataView(bytes),
+    out = new Float32Array(bytes.byteLength / 4)
+  for (let i = 0; i < out.length; i++) out[i] = view.getFloat32(i * 4, true)
+  return out
+}
+export async function loadTerrainAsset(signal?: AbortSignal): Promise<TerrainAsset> {
+  const r = await fetch(terrainBase + 'terrain.json', { signal })
+  if (!r.ok) throw new Error(`Could not load terrain metadata (HTTP ${r.status})`)
+  const meta: TerrainMeta = await r.json()
+  const [h, e, image] = await Promise.all([
+    checkedFile(meta.assets.surf, signal),
+    checkedFile(meta.assets.toterr, signal),
+    meta.imagery ? checkedFile(meta.imagery, signal) : null,
+  ])
+  const asset = { meta, heights: decode(h), errors: decode(e), imageUrl: null as string | null }
+  validateTerrain(asset)
+  if (image) asset.imageUrl = URL.createObjectURL(new Blob([image], { type: 'image/jpeg' }))
+  return asset
+}
