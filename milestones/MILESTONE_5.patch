+    let agree = 0,
+      n = 0
+    for (let t = Date.parse('2027-01-01T00:00:00Z'); t < Date.parse('2027-07-01T00:00:00Z'); t += 13 * 3_600_000) {
+      const { sun, earth } = vectorsAt(eph, t)
