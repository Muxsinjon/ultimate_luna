+    const a = base({ req })
+    const b = base({ req, weights: { sun: 0, earth: 5, joint: 0, dark: 0, blackout: 1, terrain: 0 } })
+    const st = (r: Candidate[]) => Object.fromEntries(r.map((c) => [`${c.siteId}@${c.startMs}`, [c.status, c.failed]]))
